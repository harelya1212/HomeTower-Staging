{
  "expo": {
    "experiments": {
      "baseUrl": "/HomeTower-Staging"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.harel.hometower",
      "supportsTablet": true
    },
    "android": {
      "package": "com.harel.hometower"
    },
    "plugins": [
      "expo-notifications",
      "expo-image-picker",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ]
    ],
    "name": "HomeTower",
    "orientation": "portrait",
    "owner": "aharel",
    "extra": {
      "eas": {
        "projectId": "6cad0ddf-e2eb-490e-81e5-519e48006ba3"
      }
    },
    "scheme": "hometower",
    "slug": "hometower",
    "splash": {
      "backgroundColor": "#0B2A4A",
      "image": "./assets/icon.png",
      "resizeMode": "contain"
    },
    "userInterfaceStyle": "light",
    "version": "0.1.0",
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}