rules_version = '2';
// HomeTower: the app is local-first. The ONLY cloud data is the
// marketPush subscription collection (consent-gated holdings
// snapshots), and it is written and read exclusively by the Cloud
// Functions through the Admin SDK, which bypasses these rules.
// Clients get no direct access at all.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
